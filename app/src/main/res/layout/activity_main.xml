<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full screen camera view -->
    <com.example.usbcameraviewer.CameraTextureView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Toggle sidebar button -->
    <Button
        android:id="@+id/toggleSidebarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="⚙"
        android:textSize="24sp"
        android:backgroundTint="#80000000" />

    <!-- Configuration sidebar -->
    <ScrollView
        android:id="@+id/sidebarLayout"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E0000000"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with title and close button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera Configuration"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/closeSidebarButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="✕"
                    android:textSize="20sp"
                    android:backgroundTint="#80FFFFFF"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Device Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Camera Device"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/deviceSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/focus_selector"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Resolution Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resolution"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/focus_selector"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- FPS Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frame Rate"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/fpsSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/focus_selector"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Rotation Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rotation"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/rotationSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/focus_selector"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Flip Options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Image Flip"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/flipHorizontalCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flip Horizontal"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="12dp"
                android:buttonTint="#FFFFFF"
                android:background="@drawable/checkbox_focus_selector"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <CheckBox
                android:id="@+id/flipVerticalCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flip Vertical"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="12dp"
                android:buttonTint="#FFFFFF"
                android:background="@drawable/checkbox_focus_selector"
                android:layout_marginBottom="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Audio Volume Control -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio Volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:layout_marginBottom="16dp" />

            <!-- Auto-Launch Option -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-Launch"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/autoLaunchCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch app when camera connected"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="12dp"
                android:buttonTint="#FFFFFF"
                android:background="@drawable/checkbox_focus_selector"
                android:layout_marginBottom="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Auto Start Button -->
            <Button
                android:id="@+id/autoStartButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🚀 Auto Start Video"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_green_focus"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Camera Controls Button -->
            <Button
                android:id="@+id/cameraControlsButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Camera Controls"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_red_focus"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Apply Button -->
            <Button
                android:id="@+id/applyButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Apply Configuration"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_blue_focus"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- View Logs Button -->
            <Button
                android:id="@+id/viewLogsButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="📋 View Logs"
                android:textSize="18sp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_purple_focus"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
