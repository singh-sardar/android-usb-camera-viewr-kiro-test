<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">



    <!-- 1. Permissions for Camera and Audio (DANGEROUS Permissions) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Wake Lock to prevent screensaver/ambient mode -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 2. Hardware Features for USB Camera -->
    <!-- USB Host is optional - app will work on all devices but USB features require it -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- 3. Feature for Camera Support (optional for compatibility) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebcamViewerNative"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <activity
            android:name=".UsbCameraActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.App.Starting"
            android:keepScreenOn="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- USB device attached intent - Auto-launch when camera connected -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="App Logs"
            android:theme="@style/Theme.WebcamViewerNative" />

    </application>

</manifest>