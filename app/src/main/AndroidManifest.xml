<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">



    <!-- 1. Permissions for Camera and Audio (DANGEROUS Permissions) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Wake Lock to prevent screensaver/ambient mode -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- USB Permission for managing USB device access -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />

    <!-- 2. Hardware Features for USB Camera -->
    <!-- USB Host is optional - app will work on all devices but USB features require it -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- 3. Feature for Camera Support (optional for compatibility) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    
    <!-- 4. Android TV Support (optional - makes app visible on TV launchers) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    
    <!-- 5. Touchscreen not required (for TV boxes without touchscreen) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebcamViewerNative"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- Dedicated Launcher Activity for better TV box compatibility -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Additional categories for better launcher compatibility -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            
            <!-- Metadata for Android TV compatibility -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Main Camera Activity -->
        <activity
            android:name=".UsbCameraActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.App.Starting"
            android:keepScreenOn="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|screenLayout|smallestScreenSize|layoutDirection">
            
            <!-- USB device attached intent - Auto-launch when camera connected -->
            <!-- This will still show the dialog, but our permission manager will handle it properly -->
            <intent-filter android:priority="1">
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:label="App Logs"
            android:theme="@style/Theme.WebcamViewerNative" />

    </application>

</manifest>